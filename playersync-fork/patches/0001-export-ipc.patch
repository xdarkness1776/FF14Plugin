+using MareSynchronos.API.Data;
+
+namespace PlayerSync.Interop.Ipc.Export;
+
+/// <summary>
+/// What a <see cref="MareSynchronos.PlayerData.Handlers.PairHandler"/> applied to Penumbra the last time
+/// an application finished: the data, the game path to local file mapping and the compressed alternate
+/// substitutions. Captured for the export IPC; nothing reads it back into the sync pipeline.
+/// </summary>
+internal sealed record PairExportSnapshot(
+    string DataHash,
+    DateTimeOffset AppliedAtUtc,
+    CharacterData AppliedData,
+    IReadOnlyDictionary<(string GamePath, string? Hash), string> ModdedPaths,
+    IReadOnlyDictionary<string, string> CompressionRedirects,
+    IReadOnlySet<(string GamePath, string? Hash)> ExcludedByValidation);

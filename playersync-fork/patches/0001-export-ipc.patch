@@ -0,0 +1,218 @@
+using Dalamud.Game.ClientState.Objects.SubKinds;
+using Dalamud.Plugin;
+using Dalamud.Plugin.Ipc;
+using MareSynchronos.API.Data;
+using MareSynchronos.FileCache;
+using MareSynchronos.Interop.Ipc;
+using MareSynchronos.MareConfiguration;
+using MareSynchronos.PlayerData.Pairs;
+using MareSynchronos.Services;
+using MareSynchronos.WebAPI;
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Logging;
+using PlayerSyncExport.Contracts;
+
+namespace PlayerSync.Interop.Ipc.Export;
+
+/// <summary>
+/// Export IPC (see <see cref="ExportIpc"/>). Lets a separate exporter plugin read the live,
+/// already-resolved resource mapping of a character PlayerSync is syncing (directly, through a
+/// syncshell or through ZoneSync) and copy those files into a folder the user chose.
+///
+/// Reading a character (GetCharacterState) and exporting never download, never pair, never reapply and never write
+/// to the cache or its index: the mapping comes from <see cref="MareSynchronos.PlayerData.Handlers.PairHandler.ExportSnapshot"/>.
+/// Only the separate RequestReapply gate starts PlayerSync's "reapply last received data" path (the same as its
+/// context menu), which may download missing files; the exporter calls it only for its explicitly labelled action.
+/// Destinations are validated by <see cref="ExportJobRegistry"/> here, independently of the exporter's UI.
+/// Request validation, waiting and copying live in <see cref="ExportJobRegistry"/> (shared with the exporter's tests).
+/// </summary>
+public sealed class ExportIpcProvider : IHostedService
+{
+    private readonly ILogger<ExportIpcProvider> _logger;
+    private readonly IDalamudPluginInterface _pi;
+    private readonly PairManager _pairManager;
+    private readonly ApiController _apiController;
+    private readonly FileCacheManager _fileCacheManager;
+    private readonly IpcManager _ipcManager;
+    private readonly DalamudUtilService _dalamudUtil;
+    private readonly ZoneSyncConfigService _zoneSyncConfig;
+    private readonly ExportJobRegistry _jobs;
+
+    private ICallGateProvider<int>? _getApiVersion;
+    private ICallGateProvider<uint, string>? _getCharacterState;
+    private ICallGateProvider<uint, bool>? _requestReapply;
+    private ICallGateProvider<string, string>? _startExport;
+    private ICallGateProvider<string, string>? _getExportStatus;
+    private ICallGateProvider<string, bool>? _cancelExport;
+
+    public ExportIpcProvider(ILogger<ExportIpcProvider> logger, IDalamudPluginInterface pi, PairManager pairManager,
+        ApiController apiController, FileCacheManager fileCacheManager, IpcManager ipcManager,
+        DalamudUtilService dalamudUtil, ZoneSyncConfigService zoneSyncConfig)
+    {
+        _logger = logger;
+        _pi = pi;
+        _pairManager = pairManager;
+        _apiController = apiController;
+        _fileCacheManager = fileCacheManager;
+        _ipcManager = ipcManager;
+        _dalamudUtil = dalamudUtil;
+        _zoneSyncConfig = zoneSyncConfig;
+        _jobs = new ExportJobRegistry(Resolve, ForbiddenRoots, log: (ex, msg) => _logger.LogWarning(ex, "Export IPC: {msg}", msg));
+    }
+
+    public Task StartAsync(CancellationToken cancellationToken)
+    {
+        _getApiVersion = _pi.GetIpcProvider<int>(ExportIpc.GetApiVersion);
+        _getApiVersion.RegisterFunc(() => ExportIpc.ApiVersion);
+        _getCharacterState = _pi.GetIpcProvider<uint, string>(ExportIpc.GetCharacterState);
+        _getCharacterState.RegisterFunc(id => ExportJson.Serialize(Resolve(id).State));
+        _requestReapply = _pi.GetIpcProvider<uint, bool>(ExportIpc.RequestReapply);
+        _requestReapply.RegisterFunc(RequestReapply);
+        _startExport = _pi.GetIpcProvider<string, string>(ExportIpc.StartExport);
+        _startExport.RegisterFunc(json => ExportJson.Serialize(StartExport(json)));
+        _getExportStatus = _pi.GetIpcProvider<string, string>(ExportIpc.GetExportStatus);
+        _getExportStatus.RegisterFunc(id => ExportJson.Serialize(_jobs.GetStatus(id)));
+        _cancelExport = _pi.GetIpcProvider<string, bool>(ExportIpc.CancelExport);
+        _cancelExport.RegisterFunc(_jobs.Cancel);
+        _logger.LogInformation("Export IPC v{version} registered", ExportIpc.ApiVersion);
+        return Task.CompletedTask;
+    }
+
+    public Task StopAsync(CancellationToken cancellationToken)
+    {
+        _getApiVersion?.UnregisterFunc();
+        _getCharacterState?.UnregisterFunc();
+        _requestReapply?.UnregisterFunc();
+        _startExport?.UnregisterFunc();
+        _getExportStatus?.UnregisterFunc();
+        _cancelExport?.UnregisterFunc();
+        _jobs.Dispose();
+        return Task.CompletedTask;
+    }
+
+    private ExportStartResultDto StartExport(string requestJson)
+    {
+        try
+        {
+            return _jobs.Start(ExportJson.Deserialize<ExportRequestDto>(requestJson));
+        }
+        catch (Exception ex)
+        {
+            return new() { Error = "Malformed export request: " + ex.Message };
+        }
+    }
+
+    private IEnumerable<string?> ForbiddenRoots()
+    {
+        yield return _fileCacheManager.CacheFolder;
+        yield return _ipcManager.Penumbra.ModDirectory;
+        foreach (var root in ExportPathPolicy.CommonForbiddenRoots(_pi.ConfigDirectory.Parent?.FullName, _pi.AssemblyLocation.Directory?.FullName,
+                     Path.GetDirectoryName(typeof(IDalamudPluginInterface).Assembly.Location)))
+            yield return root;
+    }
+
+    private (Pair? Pair, string? HomeWorld) FindPair(uint entityId)
+    {
+        if (entityId is 0 or uint.MaxValue) return (null, null);
+        // PlayerCharacterId and the home world dereference the game object, so read them on the framework thread.
+        return _dalamudUtil.RunOnFrameworkThread(() =>
+        {
+            var pair = _pairManager.GetVisiblePairs().FirstOrDefault(p => p.PlayerCharacterId == entityId);
+            var address = pair?.ExportHandler?.PlayerCharacter ?? nint.Zero;
+            var world = address != nint.Zero && _dalamudUtil.CreateGameObject(address) is IPlayerCharacter pc
+                ? _dalamudUtil.GetWorldName((int)pc.HomeWorld.RowId)
+                : null;
+            return (pair, string.IsNullOrEmpty(world) ? null : world);
+        }).GetAwaiter().GetResult();
+    }
+
+    private static IEnumerable<ReplacementInput> Inputs(CharacterData? data)
+        => data?.FileReplacements.SelectMany(kv => kv.Value.Select(f => new ReplacementInput(kv.Key.ToString(), f.GamePaths, f.Hash, f.FileSwapPath)))
+           ?? [];
+
+    private CharacterResolution Resolve(uint entityId)
+    {
+        var files = new Dictionary<string, ResolvedFile>(StringComparer.OrdinalIgnoreCase);
+        var state = new CharacterStateDto();
+        // The same rule GroupZoneSyncManager applies: an entry for your own character's name overrides the global setting.
+        var zoneSync = _zoneSyncConfig.Current;
+        var (effective, overridden) = ZoneSyncSettings.Effective(zoneSync.EnableGroupZoneSyncJoining, zoneSync.ZoneSyncEnabledPerCharacter, _dalamudUtil.PlayerName);
+        state.ZoneSyncJoiningGlobal = zoneSync.EnableGroupZoneSyncJoining;
+        state.ZoneSyncJoiningOverride = overridden;
+        state.ZoneSyncJoiningEffective = effective;
+        try
+        {
+            if (!_apiController.IsConnected)
+            {
+                state.Lookup = CharacterLookup.NotConnected;
+                return new(state, files);
+            }
+
+            var (pair, homeWorld) = FindPair(entityId);
+            if (pair == null)
+            {
+                state.Lookup = CharacterLookup.NotSynced;
+                return new(state, files);
+            }
+
+            state.PlayerName = pair.PlayerName;
+            state.HomeWorld = homeWorld;
+            state.IsDirectlyPaired = pair.IsDirectlyPaired;
+            state.IsZoneSyncOnly = pair.IsZoneSyncOnlyPair;
+            state.SharesZoneSyncGroup = pair.UserPair.Groups.Exists(g => g.StartsWith(Constants.GroupZoneSyncPrefix, StringComparison.Ordinal));
+            if (pair.IsPaused)
+            {
+                state.Lookup = CharacterLookup.Paused;
+                return new(state, files);
+            }
+
+            state.Lookup = CharacterLookup.Found;
+            var handler = pair.ExportHandler;
+            var received = pair.GetFilteredLastReceivedData();
+            var snapshot = handler?.ExportSnapshot;
+            state.ReceivedDataHash = received?.DataHash.Value;
+            state.AppliedDataHash = snapshot?.DataHash;
+            state.AppliedAtUtc = snapshot?.AppliedAtUtc;
+            state.HasManipulations = !string.IsNullOrEmpty(received?.ManipulationData);
+
+            var hidden = Inputs(pair.LastReceivedCharacterData).Count() - Inputs(received).Count();
+            if (hidden > 0)
+                state.Notes.Add($"{hidden} resource(s) were removed by your PlayerSync filter or permission settings (animations, VFX, sounds, minions, pets) and are not available.");
+
+            state.Resources = snapshot != null
+                ? ResourceResolver.Resolve(Inputs(snapshot.AppliedData), snapshot.ModdedPaths, snapshot.CompressionRedirects, snapshot.ExcludedByValidation,
+                    _fileCacheManager.CacheFolder, _ipcManager.Penumbra.ModDirectory, files)
+                : ResourceResolver.Unresolved(Inputs(received));
+            state.SyncState = ResourceResolver.ComputeState(state.ReceivedDataHash, handler?.IsSyncInProgress == true, state.AppliedDataHash, state.Resources);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogWarning(ex, "Export IPC: failed to build character state");
+            state.Lookup = CharacterLookup.NotSynced;
+            state.Notes.Add("PlayerSync could not read the character state: " + ex.Message);
+            files.Clear();
+        }
+
+        return new(state, files);
+    }
+
+    private bool RequestReapply(uint entityId)
+    {
+        try
+        {
+            var (pair, _) = FindPair(entityId);
+            if (pair == null || pair.IsPaused || pair.ExportHandler == null || pair.LastReceivedCharacterData == null) return false;
+            if (pair.ExportHandler.IsSyncInProgress) return true;
+            _logger.LogDebug("Export IPC: reapply requested for {pair}", pair.PairUIDName);
+            // Same path as the "Reapply last data" context menu entry: recomputes the mapping,
+            // reuses cached files and only downloads what is missing.
+            pair.ApplyLastReceivedData(forced: true);
+            return true;
+        }
+        catch (Exception ex)
+        {
+            _logger.LogWarning(ex, "Export IPC: reapply failed");
+            return false;
+        }
+    }
+}

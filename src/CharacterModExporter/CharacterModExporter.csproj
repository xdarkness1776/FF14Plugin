<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>$(ExporterVersion)</Version>
    <AssemblyName>CharacterModExporter</AssemblyName>
    <!-- Manifest fields consumed by DalamudPackager -->
    <Author>xdarkness1776</Author>
    <Name>Character Mod Exporter</Name>
    <Punchline>Export the mod files PlayerSync applied to another character into a folder you choose.</Punchline>
    <Description>An add-on for PlayerSync. Right-click a player that PlayerSync is syncing (ZoneSync, syncshell or direct pair) and choose "Export Character Mods". The exporter reads from Penumbra which of PlayerSync's cached files are applied to that character, and copies them into a folder you choose, with a manifest, a report and, when the set is complete, a Penumbra mod package for manual import.

Works with the official PlayerSync and Penumbra. It never downloads anything and never changes PlayerSync.</Description>
    <RepoUrl>https://github.com/xdarkness1776/FF14Plugin</RepoUrl>
    <Tags>playersync;penumbra;export;mods</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CharacterModExporter.Core\CharacterModExporter.Core.csproj" />
    <ProjectReference Include="..\PlayerSyncExport.Contracts\PlayerSyncExport.Contracts.csproj" />
  </ItemGroup>
</Project>
